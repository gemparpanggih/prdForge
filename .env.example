# Optional: override the local data directory.
# Defaults to ./.data
# PRD_DATA_DIR=/absolute/path/to/prd-forge-data

# Optional: base64-encoded 32-byte AES key used to encrypt provider API keys.
# If unset, PRD Forge generates .data/master.key with mode 0600 on first use.
# Generate one with: openssl rand -base64 32
# APP_ENCRYPTION_KEY=

# Optional: force the deterministic local engine even when a provider is configured.
# Useful for demos, offline work, and deterministic tests.
# PRD_FORCE_LOCAL_ENGINE=1
